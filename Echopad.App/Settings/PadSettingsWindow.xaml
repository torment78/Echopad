<Window
    x:Class="Echopad.App.Settings.PadSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Echopad.App.UI.Controls"
    xmlns:conv="clr-namespace:Echopad.App.UI.Converters"
    xmlns:local="clr-namespace:Echopad.App.Settings"
    mc:Ignorable="d"
    Title="Pad Settings"
    Width="1100"
    Height="960"
    MinWidth="900"
    MinHeight="700"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource BgBrush}"
    Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:IntEqualsConverter x:Key="IntEqualsConverter" />

        <!-- ===== Palette (GRAY THEME) ===== -->
        <SolidColorBrush x:Key="BgBrush" Color="#212121"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#212121"/>
        <SolidColorBrush x:Key="ControlBgBrush" Color="#181818"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#303030"/>
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#242424"/>
        <SolidColorBrush x:Key="ControlPressedBrush" Color="#1D1D1D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EAEAEA"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#B8B8B8"/>
        <SolidColorBrush x:Key="WaveformBorderBrush" Color="#1B1B1B"/>
        <!-- Default GroupBox style (kept for safety; specific ones are overridden below) -->
        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <!-- NEW: Flat section header (replaces GroupBox chrome for compact layout) -->
        <Style x:Key="FlatSectionHeader" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- NEW: Flat "card" container for top area -->
        <Style x:Key="TopCardBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- NEW: tiny time entry box (keeps same colors as global TextBox style) -->
        <Style x:Key="TinyTimeBox" TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- NEW: IN/OUT should match the same dark/white system, but borderless -->
        <!--<Style x:Key="TrimInOutBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TinyTimeBox}">
            <Setter Property="Background" Value="{StaticResource ControlBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style> -->

        <!-- NEW: Flat GroupBox template used ONLY where you asked (keeps header, removes outline) -->
        <Style x:Key="FlatGroupBoxNoBorder" TargetType="{x:Type GroupBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <!-- slightly tighter default margin between sections -->
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <!-- NEW: reusable "clear binding" menu for bind TextBoxes -->
        <!-- =========================================================
NEW: reusable "clear binding" menu for bind TextBoxes
========================================================= -->
        <ContextMenu x:Key="BindClearMenu">
            <MenuItem Header="Clear"
              Click="BindClearMenu_Clear_Click"/>
        </ContextMenu>

        <!-- =========================================================
NEW: BindBoxStyle (read-only display box with Clear + Delete)
========================================================= -->
        <Style x:Key="BindBoxStyle"
       TargetType="{x:Type TextBox}"
       BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="ContextMenu" Value="{StaticResource BindClearMenu}"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>

            <!-- correct way to hook event from a Style -->
            <EventSetter Event="PreviewKeyDown" Handler="BindBox_PreviewKeyDown"/>
        </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Padding="17,13" BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#69D5B0"/>
                <Setter TargetName="TabBorder" Property="Background" Value="#192D29"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

<conv:HexColorBrushConverter x:Key="Swatch"/>
<conv:BindingLabelConverter x:Key="BindingLabel"/>
    </Window.Resources>

    <Grid Margin="20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Pad settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Border Grid.Row="1" Style="{StaticResource TopCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ===== Audio File (flat, tight) ===== -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Audio File"
                                       Style="{StaticResource FlatSectionHeader}"
                                       Margin="0,0,0,2"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0"
                                         Text="{Binding ClipPath}"
                                         IsReadOnly="True"/>

                                <Button Grid.Row="0" Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Content="Browse…"
                                        Style="{StaticResource EchopadTopButtonStyle}"
                                        Click="BrowseAudio_Click"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Margin="0,6,0,0"
                                           Opacity="0.85"
                                           Text="{Binding DurationText}" />
                            </Grid>
                        </StackPanel>

                        <!-- ===== Trim (flat, compact, aligned) ===== -->
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <!-- Left side: Trim header + waveform placeholder -->
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                   Text="Trim"
                   Style="{StaticResource FlatSectionHeader}"
                   Margin="0,0,0,6"/>
                            </Grid>

                            <!-- Shared alignment grid -->
                            <Grid Grid.Column="0" Grid.ColumnSpan="2" Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <!-- NEW: add one row for Play -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Play -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- IN -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- OUT -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Reset -->
                                </Grid.RowDefinitions>

                                <!-- LEFT: waveform/spectro placeholder + PLAYHEAD OVERLAY -->
                                <Border Grid.Row="0"
                Grid.RowSpan="4"
                Grid.Column="0"
                Height="120"
                CornerRadius="8"
                Background="{StaticResource ControlBgBrush}"
                BorderBrush="{StaticResource WaveformBorderBrush}"
                BorderThickness="1"
                Opacity="0.95"
                Margin="0,0,10,0">

                                    <!-- IMPORTANT: overlay stack -->
                                    <Grid>

                                        <local:SpectrogramTrimControl x:Name="WaveHost"
      Margin="6"
      AudioPath="{Binding ClipPath}"
      DurationMs="{Binding ClipDurationMs}"
      StartMs="{Binding StartMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      EndMs="{Binding EndMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      PreviewMouseLeftButtonDown="WaveHost_PreviewMouseLeftButtonDown"
      PreviewMouseRightButtonDown="WaveHost_PreviewMouseRightButtonDown"
      PreviewMouseRightButtonUp="WaveHost_PreviewMouseRightButtonUp"
      PreviewMouseMove="WaveHost_PreviewMouseMove"/>


                                        <!-- Playhead overlay (drag surface + visuals) -->
                                        <Canvas x:Name="PlayheadOverlay"
        Panel.ZIndex="10"
        Background="Transparent"
        Margin="6"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Width="{Binding ActualWidth, ElementName=WaveHost}"
        Height="{Binding ActualHeight, ElementName=WaveHost}"
        MouseLeftButtonDown="PlayheadOverlay_MouseLeftButtonDown"
        MouseMove="PlayheadOverlay_MouseMove"
        MouseLeftButtonUp="PlayheadOverlay_MouseLeftButtonUp">


                                            <!-- fat translucent body -->
                                            <Rectangle x:Name="PlayheadBody"
                               Width="8"
                               Height="Auto"
                               Opacity="0.28"
                               RadiusX="2" RadiusY="2"
                               Fill="{DynamicResource AccentBrush}"
                               Canvas.Top="0"/>

                                            <!-- thin bright core -->
                                            <Rectangle x:Name="PlayheadCore"
                               Width="2"
                               Height="Auto"
                               Opacity="0.95"
                               RadiusX="1" RadiusY="1"
                               Fill="{DynamicResource Accent2Brush}"
                               Canvas.Top="0"/>

                                            <!-- top triangle marker -->
                                            <Polygon x:Name="PlayheadTopTri"
                             Opacity="0.95"
                             Fill="{DynamicResource Accent2Brush}"
                             Points="0,0 10,0 5,6"/>

                                            <!-- bottom triangle marker -->
                                            <Polygon x:Name="PlayheadBotTri"
                             Opacity="0.95"
                             Fill="{DynamicResource Accent2Brush}"
                             Points="0,6 10,6 5,0"/>

                                            <!-- optional larger hit targets (transparent) -->
                                            <Rectangle x:Name="PlayheadHitTop"
                               Width="26"
                               Height="18"
                               Opacity="0"
                               Fill="White"/>

                                            <Rectangle x:Name="PlayheadHitBot"
                               Width="26"
                               Height="18"
                               Opacity="0"
                               Fill="White"/>
                                        </Canvas>

                                    </Grid>
                                </Border>

                                <!-- RIGHT: Play (same size as Reset) -->
                                <Button Grid.Row="0" Grid.Column="1"
                Height="26"
                Padding="8,0"
                FontSize="12"
                Content="{Binding PreviewPlayButtonText}"
                Style="{StaticResource EchopadTopButtonStyle}"
                Click="PreviewPlayPause_Click"/>

                                <!-- RIGHT: IN -->
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,0"
                 Style="{StaticResource TrimInOutBox_Label}"
                 Tag="IN"
                 Text="{Binding StartMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0}}"
                 HorizontalContentAlignment="Right"/>

                                <!-- RIGHT: OUT -->
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,0,0"
                 Style="{StaticResource TrimInOutBox_Label}"
                 Tag="OUT"
                 Text="{Binding EndMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0}}"
                 HorizontalContentAlignment="Right"/>

                                <!-- RIGHT: Reset -->
                                <Button Grid.Row="3" Grid.Column="1"
                Margin="0,2,0,0"
                Height="26"
                Padding="8,0"
                FontSize="12"
                Content="Reset"
                Style="{StaticResource EchopadTopButtonStyle}"
                Click="ResetTrim_Click"/>
                            </Grid>
                        </Grid>

                    </Grid>
                </Border>


      <DockPanel Grid.Row="2" Margin="4,0,4,12">
        <TextBlock Text="Gain" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding GainDb, StringFormat={}{0:0.0} dB}" Width="72" TextAlignment="Right" VerticalAlignment="Center"/>
        <Slider x:Name="GainSlider" Style="{StaticResource RoundedSliderStyle}" Minimum="-60" Maximum="20" Value="{Binding GainDb}" IsSnapToTickEnabled="True" TickFrequency="1" MouseDoubleClick="GainSlider_MouseDoubleClick" ToolTip="Double-click to reset to 0 dB"/>
      </DockPanel>
      <TabControl x:Name="PadPages" Grid.Row="3">
        <TabItem Header="Pad &amp; routing" Tag="Routing">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="4,16,4,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Pad name" Style="{StaticResource FlatSectionHeader}"/>
              <TextBox Text="{Binding PadName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>
              <TextBlock Text="Source mode" Style="{StaticResource FlatSectionHeader}"/>
              <TextBlock Text="Leave both off to use an audio file." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
              <CheckBox Content="Echo — capture the rolling audio buffer" IsChecked="{Binding IsEchoMode}" Margin="0,12,0,10"/>
              <CheckBox Content="Drop folder — automatically assign audio" IsChecked="{Binding IsDropFolderMode}" Margin="0,0,0,18"/>
              <TextBlock Text="Capture input" Style="{StaticResource FlatSectionHeader}"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,18">
                <RadioButton Content="Input 1" GroupName="InputSource" IsChecked="{Binding InputSource, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" Margin="0,0,24,0"/>
                <RadioButton Content="Input 2" GroupName="InputSource" IsChecked="{Binding InputSource, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}"/>
              </StackPanel>
              <CheckBox Content="Send edit-mode playback to the monitor" IsChecked="{Binding PreviewToMonitor}"/>
              <TextBlock Text="Choose the monitor destination in Settings → Audio routing." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Pad hotkey" Style="{StaticResource FlatSectionHeader}"/>
              <TextBox Style="{StaticResource BindBoxStyle}" Text="{Binding PadHotkey}"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,24"><Button Content="Set hotkey" Click="SetPadHotkey_Click" Margin="0,0,8,0"/><Button Content="Clear" Click="ClearPadHotkey_Click"/></StackPanel>
              <TextBlock Text="MIDI trigger" Style="{StaticResource FlatSectionHeader}"/>
              <TextBox Style="{StaticResource BindBoxStyle}" Text="{Binding MidiTriggerRaw, Converter={StaticResource BindingLabel}, Mode=OneWay}"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                <Button Click="LearnMidiPad_Click" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="Learn MIDI"/><Style.Triggers><DataTrigger Binding="{Binding IsMidiLearning}" Value="True"><Setter Property="Content" Value="Listening…"/><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                <Button Content="Clear" Click="ClearPadMidi_Click"/>
              </StackPanel>
              <TextBlock Text="Use a note or CC from the MIDI input selected in Settings. Ctrl, Shift and Alt can be combined with a keyboard key." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
          </Grid></ScrollViewer>
        </TabItem>
        <TabItem Header="MIDI feedback" Tag="Midi">
          <StackPanel Margin="4,20" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="Controller LED feedback" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="These values are sent to the MIDI output selected in Settings." Margin="0,8,0,20" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
<DockPanel Margin="0,0,0,12"><TextBlock Text="Loaded / stopped" Width="170" VerticalAlignment="Center"/><TextBox Text="{Binding MidiLedActiveEntry, UpdateSourceTrigger=PropertyChanged}" MinWidth="310"/></DockPanel>
<DockPanel Margin="0,0,0,12"><TextBlock Text="Playing" Width="170" VerticalAlignment="Center"/><TextBox Text="{Binding MidiLedRunningEntry, UpdateSourceTrigger=PropertyChanged}" MinWidth="310"/></DockPanel>
<DockPanel Margin="0,0,0,12"><TextBlock Text="Cleared / empty" Width="170" VerticalAlignment="Center"/><TextBox Text="{Binding MidiLedClearEntry, UpdateSourceTrigger=PropertyChanged}" MinWidth="310"/></DockPanel>
<TextBlock Text="Enter a value from 0 to 127, OFF to disable feedback, or a raw MIDI message such as 90 3C 7F." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0"/>
          </StackPanel>
        </TabItem>
        <TabItem Header="Graphics" Tag="Graphics">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,16,4,0">
            <TextBlock Text="Pad colors &amp; PNG artwork" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Fit shows the entire image. Crop fills the pad and trims the edges from the center. Transparent PNGs keep the pad color visible underneath." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,14"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Style="{StaticResource TopCardBorderStyle}"><StackPanel>
      <TextBlock Text="Stopped" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
      <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Choose color" Click="PickActiveColor_Click" Margin="8,0,0,0"/><Border Width="26" Height="26" CornerRadius="6" Background="{Binding UiActiveHex, Converter={StaticResource Swatch}}" Margin="0,0,8,0"/><TextBox Text="{Binding UiActiveHex, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional hex; blank uses the default"/></DockPanel>
      <Border Background="#162027" BorderBrush="#3A4852" BorderThickness="1" CornerRadius="13" Height="90"><controls:PadArtwork Graphics="{Binding GraphicsPreview}" State="Loaded" Margin="1"/></Border>
      <DockPanel Margin="0,10,0,8"><Button DockPanel.Dock="Right" Content="Remove" Tag="Stopped" Click="RemovePadImage_Click" Margin="8,0,0,0"/><Button Content="Choose PNG…" Tag="Stopped" Click="ChoosePadImage_Click"/></DockPanel>
      <TextBlock Text="{Binding StoppedImageName}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,10"/>
      <DockPanel><TextBlock Text="Image sizing" VerticalAlignment="Center"/><ComboBox DockPanel.Dock="Right" Width="130" HorizontalAlignment="Right" ItemsSource="{Binding ImageFits}" SelectedItem="{Binding StoppedFit}"/></DockPanel>
      <DockPanel Margin="0,10,0,0"><TextBlock Text="Opacity"/><TextBlock Text="{Binding StoppedOpacity, StringFormat={}{0:0}%}" HorizontalAlignment="Right"/></DockPanel>
      <Slider Style="{StaticResource RoundedSliderStyle}" Minimum="0" Maximum="100" Value="{Binding StoppedOpacity}"/>
    </StackPanel></Border><Border Grid.Column="2" Style="{StaticResource TopCardBorderStyle}"><StackPanel>
      <TextBlock Text="Playing" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
      <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Choose color" Click="PickRunningColor_Click" Margin="8,0,0,0"/><Border Width="26" Height="26" CornerRadius="6" Background="{Binding UiRunningHex, Converter={StaticResource Swatch}}" Margin="0,0,8,0"/><TextBox Text="{Binding UiRunningHex, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional hex; blank uses the default"/></DockPanel>
      <Border Background="#162027" BorderBrush="#3A4852" BorderThickness="1" CornerRadius="13" Height="90"><controls:PadArtwork Graphics="{Binding GraphicsPreview}" State="Playing" Margin="1"/></Border>
      <DockPanel Margin="0,10,0,8"><Button DockPanel.Dock="Right" Content="Remove" Tag="Playing" Click="RemovePadImage_Click" Margin="8,0,0,0"/><Button Content="Choose PNG…" Tag="Playing" Click="ChoosePadImage_Click"/></DockPanel>
      <TextBlock Text="{Binding PlayingImageName}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,10"/>
      <DockPanel><TextBlock Text="Image sizing" VerticalAlignment="Center"/><ComboBox DockPanel.Dock="Right" Width="130" HorizontalAlignment="Right" ItemsSource="{Binding ImageFits}" SelectedItem="{Binding PlayingFit}"/></DockPanel>
      <DockPanel Margin="0,10,0,0"><TextBlock Text="Opacity"/><TextBlock Text="{Binding PlayingOpacity, StringFormat={}{0:0}%}" HorizontalAlignment="Right"/></DockPanel>
      <Slider Style="{StaticResource RoundedSliderStyle}" Minimum="0" Maximum="100" Value="{Binding PlayingOpacity}"/>
    </StackPanel></Border></Grid><TextBlock Text="Center and outline intensity apply to every pad: Settings → Appearance. PNGs are copied into EchoPad’s data folder when selected." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,8"/>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="Save pad" Width="110" Click="Ok_Click"/></StackPanel>
    </Grid>
</Window>
