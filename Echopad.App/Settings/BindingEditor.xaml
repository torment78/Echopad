<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:Echopad.App.UI.Converters" x:Class="Echopad.App.Settings.BindingEditor" x:Name="Editor">
  <UserControl.Resources><conv:BindingLabelConverter x:Key="BindingLabel"/></UserControl.Resources>
  <Grid Margin="0,3">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBox Text="{Binding Text, ElementName=Editor, Converter={StaticResource BindingLabel}, Mode=OneWay}" IsReadOnly="True" MinWidth="100" VerticalContentAlignment="Center" ToolTip="{Binding Text, ElementName=Editor}" PreviewMouseLeftButtonDown="Field_Click" Padding="4,7"/>
    <Button x:Name="LearnButton" Grid.Column="1" Content="Learn" Width="56" Padding="6,0" Margin="4,0,0,0" Click="Learn_Click"/>
    <Button Grid.Column="2" Content="×" FontSize="16" Padding="0" Width="28" Margin="4,0,0,0" Click="Clear_Click" ToolTip="Clear binding"/>
  </Grid>
</UserControl>
